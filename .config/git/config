[user]
  name = Connor McCarthy
  email = connor15mcc@gmail.com

[core]
  excludesfile = ~/.config/git/ignore
  pager = delta
  autocrlf = input

[url "ssh://git@github.com/"]
  insteadOf = "https://github.com/"

[url "git@github.com:"]
  insteadOf = "gh:"

[url "git@github.com:connor15mcc/"]
  insteadOf = "me:"

[url "git@github.com:lyft/"]
  insteadOf = "lyft:"

[init]
  defaultBranch = main

[blame]
  coloring = highlightRecent
  date = relative

[commit]
  template = ~/.config/git/template
  verbose = true

[log]
  abbrevCommit = true

[interactive]
  diffFilter = delta --color-only
  singlekey = true

[merge]
  autoStash = true
  conflictstyle = zdiff3

[push]
  autoSetupRemote = true

[pull]
  rebase = true

[rebase]
  autoSquash = true
  autoStash = true

[diff]
  colorMoved = default
  algorithm = histogram
  interHunkContext = 10

[branch]
  sort = -committerdate

[tag]
  sort = -taggerdate

[delta]
  navigate = true
  light = false
  line-numbers = true
  side-by-side = true

[absorb]
  oneFixupPerCommit = true
  autoStageIfNothingStaged = true

[alias]
  hack = town hack
  who = shortlog --summary --numbered --group=author --group=trailer:co-authored-by

[git-town]
  push-hook = false
  push-new-branches = false
  create-prototype-branches = true
  ship-strategy = "api"
  ship-delete-tracking-branch = false
  sync-tags = false
  sync-upstream = false
  main-branch = "main"
  sync-feature-strategy = "rebase"
  sync-perennial-strategy = "rebase"
