[user]
	name = Connor McCarthy
	email = connor15mcc@gmail.com

[core]
	excludesfile = ~/.gitignore
  pager = delta

[commit]
  verbose = true

[interactive]
  diffFilter = delta --color-only

[init]
  defaultBranch = main

[merge]
  autoStash = true
  conflictstyle = zdiff3

[push]
  autoSetupRemote = true

[rebase]
  autoSquash = true
  autoStash = true

[diff]
  colorMoved = default
  algorithm = histogram

[branch]
  sort = -committerdate

[delta]
  navigate = true
  light = false
  line-numbers = true
  side-by-side = true

[absorb]
  oneFixupPerCommit = true
  autoStageIfNothingStaged = true

[alias]
	hack = town hack

[git-town]
  push-hook = false
  push-new-branches = false
  create-prototype-branches = true
  ship-strategy = "api"
  ship-delete-tracking-branch = false
  sync-tags = false
  sync-upstream = false
  main-branch = "main"
  sync-feature-strategy = "rebase"
  sync-perennial-strategy = "rebase"
