[user]
	name = Connor McCarthy
	email = connor15mcc@gmail.com

[url "ssh://git@github.com/"]
	insteadOf = https://github.com/

[core]
	excludesfile = /Users/connormccarthy/.gitignore
  pager = delta

[interactive]
  diffFilter = delta --color-only

[merge]
  autoStash
  conflictstyle = diff3

[push]
  autoSetupRemote = true

[rebase]
  autoSquash = true
  autoStash = true

[diff]
  colorMoved = default

[delta]
  navigate = true
  light = false
  line-numbers = true
  side-by-side = true
