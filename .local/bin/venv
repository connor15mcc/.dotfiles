#!/usr/bin/env sh

# Check for --no-limit flag
NO_LIMIT=false
for arg in "$@"; do
  if [ "$arg" = "--no-limit" ]; then
    NO_LIMIT=true
    break
  fi
done

# Re-exec through ilimit if not already doing so and --no-limit not set
if [ -z "$LYFTVENV_FILTERED" ] && [ "$NO_LIMIT" = "false" ]; then
  export LYFTVENV_FILTERED=1
  "$0" "$@" 2>&1 | ilimit --limit 5
  exit $?
fi

function lyftuv() {
  if [[ ! -f "setup.py" ]]; then
    echo "setup.py not found, syncing requirements"
    uv pip sync requirements.txt --index https://artifactory.lyft.net/artifactory/api/pypi/virtual-pypi-lyft-jammy/simple/ --color always
  else
    echo "setup.py found, installing venv"
    uv pip install --index https://artifactory.lyft.net/artifactory/api/pypi/virtual-pypi-lyft-jammy/simple/ . --color always
  fi

}

echo "Warning: Running custom venv function with uv"
if [[ ! -d "venv" ]]; then
  echo "No venv found, creating one"

  # Extract Python version from requirements.in if it exists
  PYTHON_VERSION=""
  if [[ -f "requirements.in" ]]; then
    # Parse first line for pattern like "# piptools: python3.10"
    PYTHON_VERSION=$(head -n 1 requirements.in | grep -o 'python[0-9]\.[0-9]\+' || echo "")
  fi

  if [[ -n "$PYTHON_VERSION" ]]; then
    echo "Using Python version from requirements.in: $PYTHON_VERSION"
    uv venv venv --python "$PYTHON_VERSION"
  else
    echo "No Python version found in requirements.in, using default"
    uv venv venv
  fi
fi

source venv/bin/activate
lyftuv
