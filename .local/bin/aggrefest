#!/usr/bin/env sh

set -eu

CACHE_FILE="${TMPDIR:-/tmp}/aggrefest_cache.json"
CACHE_MAX_AGE=$((2 * 60 * 60))  # 2 hours in seconds

# Check if cache exists and is less than 2 hours old
if [ -f "$CACHE_FILE" ]; then
  CACHE_AGE=$(($(date +%s) - $(stat -f %m "$CACHE_FILE" 2>/dev/null || stat -c %Y "$CACHE_FILE" 2>/dev/null)))

  if [ $CACHE_AGE -lt $CACHE_MAX_AGE ]; then
    # Cache is valid, use it
    cat "$CACHE_FILE"
    exit 0
  fi
fi

# Cache is invalid or doesn't exist, fetch fresh data
aws-okta exec zimride-developer -- \
  aws s3 cp s3://lyft-control-iad/aggregated_manifests/development.json - \
  | jq -r '.[]' | tee "$CACHE_FILE"

